{
  "name": "stretchesfor",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:background": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "astro build",
    "media:curate": "node --experimental-strip-types scripts/curate-exercise-media.ts",
    "media:validate": "node scripts/validate-exercise-media.mjs",
    "media:smoke": "node --experimental-strip-types scripts/smoke-exercise-media.ts",
    "media:coverage": "node --experimental-strip-types scripts/report-media-coverage.ts --target 7",
    "media:coverage:batch1": "node --experimental-strip-types scripts/report-media-coverage.ts --target 15",
    "media:coverage:batch2": "node --experimental-strip-types scripts/report-media-coverage.ts --target 22",
    "media:coverage:batch3": "node --experimental-strip-types scripts/report-media-coverage.ts --target 28",
    "deploy": "npm run build && wrangler pages deploy dist --project-name stretchesfor --branch main",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/model-viewer": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.183.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
