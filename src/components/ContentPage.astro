---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Section {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  sections: Section[];
  lastUpdated?: string;
  tone?: 'brand' | 'danger' | 'success';
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  sections,
  lastUpdated,
  tone = 'brand',
} = Astro.props;

const toneClasses = {
  brand: 'text-brand',
  danger: 'text-danger',
  success: 'text-success',
};
---

<BaseLayout title={title} description={description}>
  <article class="container-shell py-14 sm:py-20">
    <header class="max-w-4xl">
      <p class:list={['text-sm font-semibold', toneClasses[tone]]}>{eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-balance text-4xl font-semibold tracking-[-0.05em] sm:text-6xl">{heading}</h1>
      <p class="mt-5 max-w-3xl text-pretty text-lg leading-8 text-muted">{intro}</p>
      {lastUpdated && <p class="mt-5 text-sm text-subtle">Last updated {lastUpdated}</p>}
    </header>

    <div class="mt-12 grid items-start gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16">
      <nav class="surface-card p-5 lg:sticky lg:top-24" aria-label={`${title} sections`}>
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-subtle">On this page</p>
        <ul class="mt-4 grid gap-1 text-sm">
          {sections.map((section) => (
            <li>
              <a class="block rounded-md px-2 py-2 text-muted transition-colors hover:bg-surface-raised hover:text-ink" href={`#${section.id}`}>
                {section.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="prose-sf min-w-0 max-w-3xl">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
