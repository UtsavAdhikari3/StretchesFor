---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoutineFinder from './app/RoutineFinder';
import type { GuideStep } from '../lib/guideFlow';
import { getLocaleFromPath } from '../i18n';

const { step } = Astro.props as { step: GuideStep };
const locale = getLocaleFromPath(Astro.url.pathname);
const metadata = {
  finder: {
    title: 'Find Your Everyday Routine',
    description: 'Choose an area, complete a safety check, and build a routine for your time and space.',
  },
  questions: {
    title: 'Safety Screen | Guide to Stretch',
    description: 'Complete the focused Guide to Stretch safety screen before beginning a movement routine.',
  },
  result: {
    title: 'Safety Result | Guide to Stretch',
    description: 'Review the next step suggested by your Guide to Stretch safety answers.',
  },
  routine: {
    title: 'Your Guided Movement Routine',
    description: 'Follow clear exercise steps with a timer, easier options, and optional voice guidance.',
  },
}[step];
---

<BaseLayout title={metadata.title} description={metadata.description} robots="noindex, follow">
  <meta slot="head" name="referrer" content="no-referrer" />
  <section class="border-y border-line bg-surface-raised/20 py-10 sm:py-16">
    <div class="container-shell">
      <h1 class="sr-only">{metadata.title}</h1>
      <RoutineFinder initialStep={step} locale={locale} client:only="react" />
      <noscript><p>JavaScript is needed for the questionnaire. You can still <a href="/exercises/">read every exercise guide</a>.</p></noscript>
    </div>
  </section>
</BaseLayout>
