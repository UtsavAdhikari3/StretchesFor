---
import Page from '../../exercises/[exercise].astro';
import { locales } from '../../../i18n';
import { exercises } from '../../../data/exercises';
import { getExerciseSlug } from '../../../lib/exerciseUrls';
export const getStaticPaths = () => locales.flatMap((locale) => exercises.map((exercise) => ({ params: { locale, exercise: getExerciseSlug(exercise.id) }, props: { exercise } })));
const { exercise } = Astro.props;
---
<Page exercise={exercise} />
