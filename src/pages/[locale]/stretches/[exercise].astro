---
import { locales } from '../../../i18n';
import { exercises } from '../../../data/exercises';
export const getStaticPaths = () => locales.flatMap((locale) => exercises.map((exercise) => ({ params: { locale, exercise: exercise.id } })));
return Astro.redirect(`/${Astro.params.locale}/exercises/${Astro.params.exercise}/`, 301);
---
