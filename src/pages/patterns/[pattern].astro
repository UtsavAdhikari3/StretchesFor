---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getRegion, patterns } from '../../data/content';
import type { BodyRegion, PainPattern } from '../../data/types';
export const getStaticPaths = (() => patterns.map((pattern) => ({ params: { pattern: pattern.id }, props: { pattern, region: getRegion(pattern.regionId) } }))) satisfies GetStaticPaths;
const { pattern, region } = Astro.props as { pattern: PainPattern; region: BodyRegion };
const structuredData = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: pattern.name, description: pattern.summary, lastReviewed: '2026-08-29' };
---
<BaseLayout title={pattern.name} description={`${pattern.summary} Review commonly associated symptoms, triggers, safety guidance, and next steps.`} canonicalPath={`/patterns/${pattern.id}`}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article class="container-shell py-10 sm:py-16"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: region.name, href: `/body/${region.id}` }, { label: pattern.name }]} /><header class="mt-12 max-w-3xl"><p class="text-sm font-semibold text-brand">Educational pain pattern · {region.name}</p><h1 class="mt-3 text-balance text-4xl font-semibold tracking-[-0.05em] sm:text-6xl">{pattern.name}</h1><p class="mt-5 text-pretty text-lg leading-8 text-muted">{pattern.summary}</p><div class="mt-6 rounded-xl border border-line bg-surface-raised/50 p-4 text-sm leading-6 text-muted"><strong class="text-ink">Important:</strong> This page cannot tell you whether you have this condition. Many problems share similar symptoms.</div></header><div class="mt-14 grid max-w-5xl gap-10 lg:grid-cols-[1fr_18rem]"><div class="prose-sf"><h2>Symptoms commonly associated with this pattern</h2><ul>{pattern.symptoms.map((symptom) => <li>{symptom}</li>)}</ul><h2>Common triggers</h2><ul>{pattern.triggers.map((trigger) => <li>{trigger}</li>)}</ul><h2>What changes the next step</h2><p>Major trauma, rapid worsening, inability to use the area normally, fever or feeling seriously unwell, unexplained swelling, and new neurological symptoms should move the decision away from self-guided stretching.</p><h2>Sources</h2><ul>{pattern.sources.map((source) => <li><a href={source.url} rel="noreferrer">{source.title}</a> — {source.publisher}</li>)}</ul><p class="text-sm">Content checked 29 August 2026. “Checked” does not mean medically reviewed by an individual clinician.</p></div><aside class="lg:sticky lg:top-24 lg:self-start"><div class="surface-card p-5"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand">Next step</p><h2 class="mt-2 text-xl font-semibold">Run the safety screen</h2><p class="mt-3 text-sm leading-6 text-muted">Choose {region.name} and this pattern in the private guided flow. Answers remain in browser memory only.</p><a href="/#pain-finder" class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-ink px-4 text-sm font-semibold text-canvas">Start guided check</a></div></aside></div></article>
</BaseLayout>
