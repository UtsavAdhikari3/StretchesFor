---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { conditions, getConditionContext, getConditionFlowHref, type ConditionPage } from '../data/seoContent';
import { getExercisePath } from '../lib/exerciseUrls';

export const getStaticPaths = (() => conditions.map((condition) => ({ params: { condition: condition.slug }, props: { condition } }))) satisfies GetStaticPaths;

const { condition } = Astro.props as { condition: ConditionPage };
const { region, pattern, exercises, related } = getConditionContext(condition);
const canonicalPath = `/${condition.slug}/`;
const startHref = getConditionFlowHref(condition);
const pageUrl = new URL(canonicalPath, Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'MedicalWebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: condition.title, description: condition.metaDescription, inLanguage: 'en', about: { '@type': 'MedicalCondition', name: condition.name }, mainEntity: { '@type': 'ItemList', name: `Recommended exercises for ${condition.name.toLowerCase()}`, itemListElement: exercises.map((exercise, index) => ({ '@type': 'ListItem', position: index + 1, name: exercise?.name, url: new URL(getExercisePath(exercise?.id ?? ''), Astro.site).toString() })) } },
    { '@type': 'FAQPage', mainEntity: condition.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Conditions', item: new URL('/conditions/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: condition.name, item: pageUrl },
    ] },
  ],
};
---

<BaseLayout title={condition.title} description={condition.metaDescription} canonicalPath={canonicalPath} imageAlt={`${condition.title} guide from StretchesFor`} ogType="article">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article>
    <header class="border-b border-line">
      <div class="container-shell py-10 sm:py-16 lg:py-20">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Conditions', href: '/conditions/' }, { label: condition.name }]} />
        <div class="mt-10 grid items-end gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
          <div class="max-w-4xl"><p class="text-sm font-semibold text-brand">Evidence-aware movement guide</p><h1 class="mt-3 text-balance text-4xl font-semibold tracking-[-0.055em] sm:text-6xl lg:text-7xl">{condition.title}</h1><p class="mt-6 max-w-3xl text-pretty text-lg leading-8 text-muted">{condition.summary}</p><a href={startHref} class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-lg bg-ink px-5 text-sm font-semibold text-canvas transition-[opacity,transform] hover:-translate-y-0.5 hover:opacity-85">Start stretching <span aria-hidden="true">→</span></a></div>
          <aside class="surface-card p-5" aria-label="Guide summary"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand">At a glance</p><dl class="mt-4 grid gap-4 text-sm"><div><dt class="text-subtle">Body area</dt><dd class="mt-1 font-semibold">{region?.name}</dd></div><div><dt class="text-subtle">Exercises</dt><dd class="mt-1 font-semibold">{exercises.length} gentle options</dd></div><div><dt class="text-subtle">Approach</dt><dd class="mt-1 font-semibold">Screen first, move gently</dd></div></dl></aside>
        </div>
      </div>
    </header>

    <div class="container-shell grid gap-12 py-14 lg:grid-cols-[minmax(0,1fr)_16rem] lg:py-20">
      <div class="min-w-0">
        <section aria-labelledby="understanding-heading">
          <p class="text-sm font-semibold text-brand">Understanding the problem</p><h2 id="understanding-heading" class="mt-2 text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">What can {condition.name.toLowerCase()} feel like?</h2><p class="mt-5 text-pretty leading-8 text-muted">{region?.summary} The same symptom can have several causes, and a web page cannot diagnose which tissue is involved. The descriptions below are useful for orientation, not for confirming a condition.</p>
          {pattern && <div class="mt-6 rounded-xl border border-brand/25 bg-brand/8 p-5"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand">One common movement-related pattern</p><h3 class="mt-2 text-lg font-semibold">{pattern.name}</h3><p class="mt-2 leading-7 text-muted">{pattern.summary}</p></div>}
        </section>

        <section class="mt-14 grid gap-8 md:grid-cols-2" aria-label="Common causes and symptoms">
          <div><h2 class="text-2xl font-semibold tracking-[-0.035em]">Common causes and contributors</h2><ul class="mt-5 grid gap-3 text-muted">{condition.causes.map((cause) => <li class="flex gap-3 leading-7"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span><span>{cause}</span></li>)}</ul></div>
          <div><h2 class="text-2xl font-semibold tracking-[-0.035em]">Common symptoms</h2><ul class="mt-5 grid gap-3 text-muted">{condition.symptoms.map((symptom) => <li class="flex gap-3 leading-7"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span><span>{symptom}</span></li>)}</ul></div>
        </section>

        <section id="recommended-stretches" class="mt-16 scroll-mt-24" aria-labelledby="stretches-heading">
          <p class="text-sm font-semibold text-brand">Recommended exercises</p><h2 id="stretches-heading" class="mt-2 text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">Gentle stretches to try</h2><p class="mt-5 max-w-3xl text-pretty leading-8 text-muted">{condition.movementNote} Review each setup before you begin, breathe normally, and use the easier option whenever you need it.</p>
          <div class="mt-8 grid gap-5">{exercises.map((exercise, index) => exercise && <article class="surface-card grid gap-5 p-5 sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:items-center sm:p-6"><span class="grid size-10 place-items-center rounded-full bg-brand/10 text-sm font-bold text-brand" aria-hidden="true">{index + 1}</span><div><h3 class="text-xl font-semibold tracking-[-0.025em]"><a href={getExercisePath(exercise.id)} class="hover:text-brand">{exercise.name}</a></h3><p class="mt-2 text-sm leading-6 text-muted">{exercise.direction}. Target: {exercise.feltArea}. Suggested dose: {exercise.dose}.</p></div><a href={getExercisePath(exercise.id)} class="inline-flex min-h-11 items-center text-sm font-semibold text-brand hover:text-brand-hover">View guide →</a></article>)}</div>
          <div class="mt-8 rounded-2xl border border-brand/30 bg-brand/8 p-6 sm:flex sm:items-center sm:justify-between sm:gap-6"><div><h3 class="text-xl font-semibold">Ready for guided movement?</h3><p class="mt-2 text-sm leading-6 text-muted">Your body area{condition.patternId ? ' and matching symptom pattern are' : ' is'} preselected. The existing safety screen comes before the routine.</p></div><a href={startHref} class="mt-5 inline-flex min-h-12 shrink-0 items-center rounded-lg bg-ink px-5 text-sm font-semibold text-canvas hover:opacity-85 sm:mt-0">Start stretching</a></div>
        </section>

        <section id="safety" class="mt-16 scroll-mt-24" aria-labelledby="safety-heading"><div class="rounded-2xl border border-warning/40 bg-warning/5 p-6 sm:p-8"><p class="text-sm font-semibold text-warning">Safety first</p><h2 id="safety-heading" class="mt-2 text-3xl font-semibold tracking-[-0.04em]">When to stop or seek care</h2><p class="mt-4 leading-7 text-muted">Stop the exercise if pain becomes sharp, spreading, electrical, or stronger. Do not use stretching to delay medical care. Seek prompt or urgent help for:</p><ul class="mt-5 grid gap-3 text-muted">{condition.redFlags.map((flag) => <li class="flex gap-3 leading-7"><span class="font-bold text-warning" aria-hidden="true">!</span><span>{flag}</span></li>)}</ul><p class="mt-5 text-sm leading-6 text-subtle">If you are unsure whether a symptom is safe to exercise, pause and ask a qualified health professional. <a href="/medical-disclaimer/" class="font-semibold text-brand hover:text-brand-hover">Read the full medical disclaimer.</a></p></div></section>

        <section id="faqs" class="mt-16 scroll-mt-24" aria-labelledby="faq-heading"><p class="text-sm font-semibold text-brand">Common questions</p><h2 id="faq-heading" class="mt-2 text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">FAQs about {condition.keyword}</h2><div class="mt-7 divide-y divide-line border-y border-line">{condition.faqs.map((faq) => <details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 font-semibold"><span>{faq.question}</span><span class="text-xl font-normal text-brand group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-3xl pb-2 pr-8 leading-7 text-muted">{faq.answer}</p></details>)}</div></section>

        <section class="mt-16" aria-labelledby="related-heading"><h2 id="related-heading" class="text-2xl font-semibold tracking-[-0.035em]">Related stretch guides</h2><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{related.map((item) => item && <a href={`/${item.slug}/`} class="surface-card group p-5 transition-[border-color,transform] hover:-translate-y-0.5 hover:border-line-strong"><p class="text-xs font-semibold uppercase tracking-[0.1em] text-brand">Related guide</p><h3 class="mt-2 font-semibold group-hover:text-brand">{item.title}</h3></a>)}</div><p class="mt-6 text-sm leading-6 text-muted">You can also explore the broader <a href={`/body/${condition.regionId}/`} class="font-semibold text-brand hover:text-brand-hover">{region?.name.toLowerCase()} body-area guide</a> or browse <a href="/exercises/" class="font-semibold text-brand hover:text-brand-hover">all exercise guides</a>.</p></section>
      </div>
      <aside class="hidden lg:block" aria-label="On this page"><nav class="sticky top-24 border-l border-line pl-5 text-sm"><p class="font-semibold">On this page</p><ul class="mt-4 grid gap-3 text-muted"><li><a href="#understanding-heading" class="hover:text-ink">Overview</a></li><li><a href="#recommended-stretches" class="hover:text-ink">Recommended stretches</a></li><li><a href="#safety" class="hover:text-ink">Safety</a></li><li><a href="#faqs" class="hover:text-ink">FAQs</a></li></ul></nav></aside>
    </div>
  </article>
</BaseLayout>
