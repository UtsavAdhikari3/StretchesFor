---
import type { GetStaticPaths } from 'astro';
import { exercises } from '../../data/exercises';

export const getStaticPaths = (() => exercises.map((exercise) => ({
  params: { exercise: exercise.id },
}))) satisfies GetStaticPaths;

return Astro.redirect(Astro.params.exercise === 'open-book' ? '/exercises/open-book-stretch/' : `/exercises/${Astro.params.exercise}/`, 301);
---
