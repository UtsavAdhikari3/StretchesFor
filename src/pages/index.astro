---
import BaseLayout from '../layouts/BaseLayout.astro';
import { regions } from '../data/content';
import { everydayRoutines } from '../data/everydayRoutines';
import { getLocaleFromPath, localePath, t } from '../i18n';
const locale = getLocaleFromPath(Astro.url.pathname);
const tr = (s: string) => t(locale, s);
const path = (s: string) => localePath(locale, s);
const title = 'Everyday stretches and simple mobility routines';
const description = 'Find a comfortable stretching routine for your body, time, and space. Explore 48 exercise guides and six everyday routines, with a safety check before you begin.';
const url = new URL(path('/'), Astro.site).toString();
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Stretches For', url, description: tr(description), inLanguage: locale };
---
<BaseLayout title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="sf-hero container-shell">
    <div class="sf-hero-copy"><p class="sf-eyebrow">{tr('A little movement. A better everyday.')}</p><h1>{tr('Make room for')} <span>{tr('comfortable movement.')}</span></h1><p class="sf-lead">{tr('Stiff from sitting? Ready for a gentle reset? Find a short routine that fits your body, your time, and the space you have.')}</p><div class="sf-actions"><a class="sf-button" href={path('/guide/locate/')}>{tr('Find my routine')} <span aria-hidden="true">↗</span></a><a class="sf-button sf-button-secondary" href={path('/exercises/')}>{tr('Browse exercises')}</a></div><p class="sf-small">{tr('Free to use. No account. Move at your own pace.')}</p></div>
    <div class="sf-hero-panel"><div class="sf-panel-top"><span class="sf-dot"></span>{tr('A break that fits your day')}<span class="sf-tag">5 {tr('min')}</span></div><div class="sf-orbit" aria-hidden="true"><span class="sf-orbit-ring"></span><span class="sf-orbit-ring"></span><span class="sf-orbit-ring"></span><span class="sf-orbit-word">↗</span></div><div class="sf-preview-copy"><p class="sf-eyebrow">{tr('Start small. Stay comfortable.')}</p><h2>{tr('Your next movement break')}</h2><ol class="sf-preview-list"><li><span>01</span>{tr('Choose your area')}</li><li><span>02</span>{tr('Check in with your body')}</li><li><span>03</span>{tr('Follow your routine')}</li></ol></div></div>
  </section>
  <section class="sf-section sf-area-section" id="pain-finder"><div class="container-shell"><div class="sf-section-heading"><div><p class="sf-eyebrow">{tr('Start where you feel it')}</p><h2>{tr('What needs a little attention?')}</h2></div><p>{tr('Choose an area for a personal routine, or explore its exercise guide.')}</p></div><div class="sf-area-grid">{regions.filter(r => !['chest', 'abdomen', 'lower-abdomen-groin'].includes(r.id)).map((region, index) => <div class="sf-area-card"><a href={path(`/guide/locate/?region=${region.id}`)}><span class="sf-area-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><strong>{tr(region.name)}</strong><span aria-hidden="true">↗</span></a><a class="sf-area-guide" href={path(`/body/${region.id}/`)}>{tr('Read area guide')}</a></div>)}</div></div></section>
  <section class="sf-section container-shell"><div class="sf-section-heading"><div><p class="sf-eyebrow">{tr('Good places to begin')}</p><h2>{tr('Small routines for real life')}</h2></div><a class="sf-link" href={path('/routines/')}>{tr('View all routines')} →</a></div><div class="sf-card-grid">{everydayRoutines.slice(0, 3).map((routine, index) => <a class="sf-routine-card" href={path(`/routines/${routine.id}/`)}><span class="sf-card-number" aria-hidden="true">0{index + 1}</span><p class="sf-eyebrow">{tr(index === 0 ? 'Between tasks' : index === 1 ? 'A gentle start' : 'After a long day')}</p><h3>{tr(routine.name)}</h3><p>{tr(routine.description)}</p><span class="sf-link">{tr('Explore routine')} →</span></a>)}</div></section>
  <section class="sf-section container-shell"><div class="sf-explain"><div><p class="sf-eyebrow">{tr('Guidance, without the guesswork')}</p><h2>{tr('Simple steps. Useful choices.')}</h2><p class="sf-lead">{tr('Every exercise includes clear setup steps, a suggested dose, common mistakes, and an easier option. Your routine starts with a short safety check.')}</p><a class="sf-link" href={path('/medical-disclaimer/')}>{tr('Read the safety approach')} →</a></div><div class="sf-feature-list"><div><span>01</span><div><h3>{tr('Fit your space')}</h3><p>{tr('Choose seated, standing, or floor movements and the support you have nearby.')}</p></div></div><div><span>02</span><div><h3>{tr('Keep it comfortable')}</h3><p>{tr('Use a small range, pause when you need to, and stop if symptoms worsen.')}</p></div></div><div><span>03</span><div><h3>{tr('Build a small habit')}</h3><p>{tr('A short movement break can fit between tasks. You do not need a perfect routine to begin.')}</p></div></div></div></div></section>
  <section class="sf-section container-shell sf-faq"><p class="sf-eyebrow">{tr('Before you start')}</p><h2>{tr('A few helpful answers')}</h2>{[
    ['Do I need equipment?', 'Many movements need only a stable chair or a little clear space. Tell the guide what you can use and it will filter your routine.'],
    ['Can I use this if I have pain?', 'Choose pain or discomfort in the guide to follow the symptom screening pathway. An online guide cannot diagnose the cause or replace an individual assessment.'],
    ['Do all exercises have pictures?', 'Some exercises include an illustration. Every exercise has written steps, dosage, easier options, and safety notes that you can read before starting.'],
    ['How long should I stretch?', 'Choose a 3, 5, or 10 minute window. Follow each movement’s suggested dose and keep it comfortable; a shorter routine is fine.'],
  ].map(([question, answer]) => <details><summary>{tr(question)}</summary><p>{tr(answer)}</p></details>)}</section>
</BaseLayout>
